# Required for ALLOW_ORDER on serverless deployments; never commit credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Storage / Upstash integration may auto-inject these alternatives.
# Used only when both UPSTASH values above are absent/empty. Never mix pairs.
# A partial pair in either naming scheme is a configuration error.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Local development only; no order or brokerage configuration exists.
PORT=3000

MAX_CHASE_DISTANCE_USD=2.0

# QStash: server-only signing keys; token is needed for schedule management.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Exact HTTPS Preview destination including /api/watch/xauusd (no query).
WATCH_DESTINATION_URL=
# Used only by the manual setup script; never scheduled during build.
WATCH_TARGET_ENV=preview
# Optional regional QStash API URL supplied by your QStash console.
# QSTASH_URL=
# Optional Vercel Protection Bypass for Automation, never log or commit value.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Trading Economics server-side API credential with markets + intraday entitlement.
# Sent only in Authorization header; missing or unverified data blocks execution.
TRADING_ECONOMICS_API_KEY=

# Validated DXY only; free host is pinned in adapter.
ITICK_ENV=free
ITICK_API_KEY=
